mcp-class = Klasse
mcp-description = Beschreibung
mcp-schema = Parameter (JSON-Schema)
mcp-no-tools = Keine Werkzeuge verfügbar.
mcp-token = Zugangstoken
mcp-token-help = Den Token in den lokalen Client kopieren. Neu erzeugen widerruft den alten Token sofort. Der Token bleibt verborgen, bis „Token anzeigen“ gewählt wird.
mcp-show-token = Token anzeigen
mcp-hide-token = Token verbergen
mcp-copy-token = Token kopieren
mcp-regenerate-token = Token neu erzeugen
mcp-token-regenerated = Ein neuer Token wurde erzeugt. Die Clients aktualisieren; der alte Token ist nicht mehr gültig.
