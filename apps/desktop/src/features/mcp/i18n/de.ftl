mcp-connect-title = Mit { $program } verbinden
mcp-client-state-notConnected = Noch nicht verbunden.
mcp-client-state-connected = Bereits verbunden.
mcp-client-state-outdated = Verbunden, aber der Eintrag ist veraltet (z. B. anderer Programmpfad).
mcp-client-state-blocked = Die Datei kann nicht geändert werden.
mcp-client-file = Konfigurationsdatei: { $path }
mcp-allow-crawl = Agent darf Crawls starten
mcp-allow-crawl-help = Lesen ist immer erlaubt. Die Freigabe gilt für alle verbundenen Programme und lässt sich im Reiter „Werkzeuge“ ändern.
mcp-connect = Verbinden
mcp-update = Aktualisieren
mcp-disconnect = Trennen
mcp-copy-entry = Eintrag kopieren
mcp-entry-copied = Eintrag in die Zwischenablage kopiert. Zum Einfügen von Hand in die Konfiguration des Programms.
mcp-show-changes = Änderungen anzeigen
mcp-changes-help = Nur geänderte Zeilen; Geheimnisse anderer Einträge sind maskiert. Alle übrigen Zeilen der Datei bleiben unverändert.
mcp-client-done-connected = Verbunden. Starte in { $program } eine neue Sitzung, damit OpenSpider dort erscheint.
mcp-client-done-unchanged = Bereits verbunden, die Datei ist unverändert. Starte in { $program } eine neue Sitzung, falls OpenSpider dort noch fehlt.
mcp-client-done-disconnected = Getrennt. Starte in { $program } eine neue Sitzung.
mcp-client-problem-syntax = Die Datei ist kein gültiges JSON bzw. TOML (Zeile { $line }). OpenSpider ändert sie nicht. Datei im Programm prüfen oder den Eintrag kopieren und von Hand einfügen.
mcp-client-problem-unsupported = Die Datei ist gültig, aber so aufgebaut, dass OpenSpider den Eintrag nicht ändern kann, ohne andere Zeilen umzuschreiben. Den Eintrag kopieren und von Hand einfügen.
mcp-client-problem-symlink = Die Konfigurationsdatei ist eine Verknüpfung (Symlink). OpenSpider schreibt nicht über Verknüpfungen. Den Eintrag kopieren und von Hand einfügen.
mcp-client-changed = Die Datei wurde während des Verbindens von einem anderen Programm geändert. Nichts wurde geschrieben; erneut versuchen.
mcp-diff = Konfigurations-Diff
mcp-no-changes = Keine Änderungen erforderlich.
mcp-backup = Sicherung: { $path }
mcp-time = Zeit (UTC)
mcp-parameters = Parameter (ohne Geheimnisse)
mcp-duration = Dauer
mcp-result-size = Ergebnisgröße
