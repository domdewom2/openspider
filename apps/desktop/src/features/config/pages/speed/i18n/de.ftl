# Seite Geschwindigkeit (M2-U13)
config-speed-desc = Die Thread-Anzahl wirkt sofort, auch während der Crawl läuft. Alle übrigen Geschwindigkeitseinstellungen brauchen eine Pause.
config-sec-speed-parallel = Parallele Abrufe
config-sec-speed-rate = Abrufrate
config-f-speed-threads = Max. Threads
config-f-speed-max-per-host = Max. gleichzeitige Verbindungen pro Host
config-f-speed-auto = Thread-Anzahl automatisch anpassen
config-f-speed-max-urls-per-sec = Max. URLs pro Sekunde
config-f-speed-adaptive-throttle = Bei Überlastung des Servers automatisch drosseln
config-hint-rate = Dezimalzahlen sind erlaubt, z. B. 0,5 für eine Anfrage alle 2 Sekunden.
config-unlimited-rate = Nicht begrenzt
config-threads-high = { $threads } Threads belasten den Server stark. Bitte sicherstellen, dass die Website das verträgt.
