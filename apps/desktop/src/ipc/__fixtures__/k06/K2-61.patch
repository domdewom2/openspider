diff --git a/crates/os-analyze/src/details/mod.rs b/crates/os-analyze/src/details/mod.rs
index 5b50269..733bf93 100644
--- a/crates/os-analyze/src/details/mod.rs
+++ b/crates/os-analyze/src/details/mod.rs
@@ -184,0 +185,150 @@ pub fn url_details(
+
+/// Every Internal column for one URL, including external/hidden URLs. Uses the same
+/// expressions and multi-column expansion as the main table (UI-031, OUT-021).
+pub fn url_properties(
+    file: &CrawlFile,
+    cfg: &CrawlConfig,
+    url: UrlId,
+) -> Result<Vec<(String, Value)>, ViewError> {
+    let tabs = crate::tabs::configured_for_file(cfg, file);
+    let mut q = crate::views::ViewQuery::new("Internal", "All");
+    q.columns = crate::views::ColumnSelection::All;
+    q.limit = 1;
+    let page = crate::views::query_url_ids_in(&tabs, file, cfg, &q, &[url], true)?;
+    Ok(page
+        .rows
+        .into_iter()
+        .next()
+        .map(|row| page.columns.into_iter().zip(row).collect())
+        .unwrap_or_default())
+}
+
+/// Canonical HTTP-header detail rows (UI-042/OUT-021), preserving duplicate positions.
+/// The generic F05 table source remains available unchanged.
+pub fn stored_header_details(
+    file: &CrawlFile,
+    _: &CrawlConfig,
+    req: &DetailReq<'_>,
+) -> Result<DetailRows, ViewError> {
+    let columns = [
+        ("Address", ColumnKind::Url),
+        ("Direction", ColumnKind::Text),
+        ("Header Name", ColumnKind::Text),
+        ("Header Value", ColumnKind::Text),
+    ];
+    let mut order = Vec::new();
+    for key in req.sort {
+        let (sql, text) = match key.column.as_str() {
+            "Address" => ("u.address", false),
+            "Direction" => ("h.direction", true),
+            "Header Name" => ("h.name", true),
+            "Header Value" => ("h.value", true),
+            _ => {
+                return Err(ViewError::Store(os_store::StoreError::InvalidInput(
+                    format!("Unknown header sort column: {}", key.column),
+                )))
+            }
+        };
+        let direction = if key.descending { "DESC" } else { "ASC" };
+        order.push(format!("({sql} IS NULL OR {sql}='') ASC"));
+        order.push(format!(
+            "{sql} {} {direction}",
+            if text { "COLLATE OS_TEXT" } else { "" }
+        ));
+    }
+    order.push("pick.rank,h.direction,h.position".into());
+    let ids = serde_json::to_string(&req.url_ids.iter().map(|id| id.0).collect::<Vec<_>>())
+        .expect("integer IDs");
+    let from="FROM http_headers h JOIN urls u ON u.id=h.url_id JOIN (SELECT value AS id,MIN(CAST(key AS INTEGER)) AS rank FROM json_each(?1) GROUP BY value) pick ON pick.id=h.url_id";
+    let total = file
+        .conn()
+        .query_row(&format!("SELECT COUNT(*) {from}"), [&ids], |r| r.get(0))?;
+    let mut stmt = file.conn().prepare(&format!(
+        "SELECT u.address,h.direction,h.name,h.value {from} ORDER BY {} LIMIT ?2 OFFSET ?3",
+        order.join(",")
+    ))?;
+    let rows = stmt
+        .query_map(
+            rusqlite::params![ids, req.limit.min(500), req.offset.min(i64::MAX as u64)],
+            |r| {
+                let direction: String = r.get(1)?;
+                let name: String = r.get(2)?;
+                let raw: String = r.get(3)?;
+                // Same sensitive-header policy as os-fetch; os-analyze has no fetch dependency.
+                let sensitive = matches!(
+                    name.trim().to_ascii_lowercase().as_str(),
+                    "authorization"
+                        | "proxy-authorization"
+                        | "cookie"
+                        | "set-cookie"
+                        | "set-cookie2"
+                        | "x-api-key"
+                        | "api-key"
+                        | "x-auth-token"
+                        | "x-access-token"
+                );
+                Ok(vec![
+                    Value::Text(r.get(0)?),
+                    Value::from(if direction == "request" {
+                        "Request"
+                    } else {
+                        "Response"
+                    }),
+                    name.into(),
+                    Value::from(if sensitive {
+                        "<redacted>".to_string()
+                    } else {
+                        raw
+                    }),
+                ])
+            },
+        )?
+        .collect::<Result<Vec<_>, _>>()?;
+    Ok(DetailRows {
+        columns: columns
+            .into_iter()
+            .map(|(name, kind)| (name.into(), kind))
+            .collect(),
+        rows,
+        total,
+        notes: Vec::new(),
+    })
+}
+
+/// Preserves the complete selection contract at the parameter-aware anchor extension.
+pub fn selected_anchor_details(
+    file: &CrawlFile,
+    _: &CrawlConfig,
+    req: &DetailReq<'_>,
+) -> Result<DetailRows, ViewError> {
+    let sort = req
+        .sort
+        .iter()
+        .map(|key| os_store::queries::LinkSortKey {
+            column: key.column.clone(),
+            desc: key.descending,
+        })
+        .collect::<Vec<_>>();
+    let rows = os_store::queries::anchors::selected_detail_rows(
+        file,
+        req.url_ids,
+        req.params,
+        &sort,
+        req.offset,
+        req.limit,
+    )
+    .map_err(|e| match e {
+        os_store::StoreError::NotImplemented(owner) => ViewError::NotImplemented(owner),
+        other => ViewError::Store(other),
+    })?;
+    Ok(DetailRows {
+        columns: rows
+            .columns
+            .into_iter()
+            .map(|name| (name, ColumnKind::Text))
+            .collect(),
+        rows: rows.rows,
+        total: rows.total,
+        notes: Vec::new(),
+    })
+}
diff --git a/crates/os-analyze/src/views.rs b/crates/os-analyze/src/views.rs
index b9e3da7..2dce8b7 100644
--- a/crates/os-analyze/src/views.rs
+++ b/crates/os-analyze/src/views.rs
@@ -297,0 +298,34 @@ pub fn resolve_name(input: &str) -> Result<(String, String), NameError> {
+
+/// Offset page restricted to explicit URL IDs, bound as one JSON parameter (K2-61).
+/// `outside_population` supports URL Details for hidden and external URLs using Internal columns.
+/// This variant never creates persistent SQL strings or reusable cursors for a transient selection.
+pub fn query_url_ids_in(
+    tabs: &[TabDef],
+    file: &CrawlFile,
+    cfg: &CrawlConfig,
+    query: &ViewQuery,
+    ids: &[UrlId],
+    outside_population: bool,
+) -> Result<ViewPage, ViewError> {
+    if matches!(query.start, PageStart::Cursor(_)) {
+        return Err(ViewError::ForeignCursor);
+    }
+    let mut built = build::build(tabs, query, cfg)?;
+    let selection = "u.id IN (SELECT value FROM json_each(:os_selected_url_ids))";
+    built.plan.population_sql = if outside_population {
+        selection.into()
+    } else {
+        format!("({}) AND ({selection})", built.plan.population_sql)
+    };
+    built.plan.params.push((
+        ":os_selected_url_ids".into(),
+        Value::Text(
+            serde_json::to_string(&ids.iter().map(|id| id.0).collect::<Vec<_>>())
+                .expect("integer IDs"),
+        ),
+    ));
+    let ready = is_ready(file, cfg, &built)?;
+    let mut page = exec::query_page(file, &built, query, ready)?;
+    page.next_cursor = None;
+    Ok(page)
+}
diff --git a/crates/os-app/src/pool.rs b/crates/os-app/src/pool.rs
index 8c5f1ee..01740ed 100644
--- a/crates/os-app/src/pool.rs
+++ b/crates/os-app/src/pool.rs
@@ -164,0 +165,22 @@ impl ReadPool {
+    /// Runs all reads in one SQLite snapshot, rolling back even when the callback fails.
+    /// Additive K2-61 extension for versioned app views and exports.
+    pub async fn run_snapshot<T: Send + 'static>(
+        &self,
+        crawl: CrawlKey,
+        f: impl FnOnce(&CrawlFile, &CancelToken) -> Result<T, StoreError> + Send + 'static,
+    ) -> Result<T, CmdError> {
+        self.run(crawl, move |file, cancel| {
+            file.conn().execute_batch("BEGIN DEFERRED")?;
+            let result = std::panic::catch_unwind(AssertUnwindSafe(|| f(file, cancel)));
+            let rollback = file.conn().execute_batch("ROLLBACK");
+            match result {
+                Ok(result) => result.and_then(|value| {
+                    rollback?;
+                    Ok(value)
+                }),
+                Err(panic) => std::panic::resume_unwind(panic),
+            }
+        })
+        .await
+    }
+
diff --git a/crates/os-export/src/detail_export.rs b/crates/os-export/src/detail_export.rs
index 05606e4..fd934d8 100644
--- a/crates/os-export/src/detail_export.rs
+++ b/crates/os-export/src/detail_export.rs
@@ -47,0 +48,54 @@ pub fn export_detail(
+
+/// Paged variant of the F05 detail export for app operations (additive K2-61).
+/// Keeps memory bounded and checks cancellation between source pages and rows.
+pub fn export_detail_with_ctx(
+    kind: DetailKind,
+    job: &TableJob<'_>,
+    req: &DetailReq<'_>,
+    writer: &mut dyn crate::TableWriter,
+    ctx: &mut crate::types::ExportCtx<'_>,
+) -> Result<u64, ExportError> {
+    let (_, source) = detail_source(kind);
+    let source = match kind {
+        DetailKind::Headers => os_analyze::details::stored_header_details,
+        DetailKind::Anchors => os_analyze::details::selected_anchor_details,
+        _ => source,
+    };
+    let mut offset = 0;
+    let mut header = None;
+    loop {
+        ctx.checkpoint()?;
+        let page = source(
+            job.file,
+            job.cfg,
+            &DetailReq {
+                url_ids: req.url_ids,
+                params: req.params,
+                sort: req.sort,
+                offset,
+                limit: 500,
+            },
+        )?;
+        let (names, kinds): (Vec<_>, Vec<_>) = page.columns.into_iter().unzip();
+        if let Some(expected) = &header {
+            if expected != &names {
+                return Err(ExportError::Write(
+                    "Detail columns changed in snapshot".into(),
+                ));
+            }
+        } else {
+            writer.header(&names)?;
+            header = Some(names);
+        }
+        let count = page.rows.len() as u64;
+        for row in page.rows {
+            ctx.checkpoint()?;
+            writer.row(&kinds, &row)?;
+        }
+        offset += count;
+        (ctx.progress)(offset);
+        if count == 0 || offset >= page.total {
+            return Ok(offset);
+        }
+    }
+}
diff --git a/crates/os-export/src/pipeline.rs b/crates/os-export/src/pipeline.rs
index 1c016d6..223717f 100644
--- a/crates/os-export/src/pipeline.rs
+++ b/crates/os-export/src/pipeline.rs
@@ -304,0 +305,87 @@ pub fn export_report_in(
+
+/// App export extension preserving uploaded list order without changing the M1 writer API.
+/// Only Internal:All in list mode is affected; other views retain their visible ordering.
+#[allow(clippy::too_many_arguments)]
+pub fn write_view_with_upload_order(
+    tabs: &[TabDef],
+    file: &CrawlFile,
+    cfg: &CrawlConfig,
+    q: &ViewQuery,
+    preserve: bool,
+    open: impl FnOnce() -> Result<Box<dyn TableWriter>, ExportError>,
+) -> Result<ExportFileInfo, ExportError> {
+    if !preserve
+        || file.meta()?.mode != os_model::CrawlMode::List
+        || !q.tab.eq_ignore_ascii_case("Internal")
+        || !q.filter.eq_ignore_ascii_case("All")
+    {
+        return write_view(tabs, file, cfg, q, open);
+    }
+    let mut probe = q.clone();
+    probe.limit = 1;
+    probe.start = PageStart::Offset(0);
+    let page = views::query_view_in(tabs, file, cfg, &probe)?;
+    let tab = names::find_tab(tabs, &q.tab).expect("resolved tab");
+    let mut kinds = vec![ColumnKind::Text];
+    kinds.extend(page.columns.iter().map(|n| column_kind(tab, n)));
+    let mut header = vec!["Original Url".into()];
+    header.extend(page.columns.iter().cloned());
+    let mut out = open()?;
+    out.header(&header)?;
+    let mut cursor = 0i64;
+    loop {
+        let mut stmt=file.conn().prepare("SELECT position,original,url_id,outcome FROM list_input WHERE position>=?1 ORDER BY position LIMIT 500").map_err(StoreError::from)?;
+        let input = stmt
+            .query_map([cursor], |r| {
+                Ok((
+                    r.get::<_, i64>(0)?,
+                    r.get::<_, String>(1)?,
+                    r.get::<_, Option<i64>>(2)?,
+                    r.get::<_, String>(3)?,
+                ))
+            })
+            .map_err(StoreError::from)?
+            .collect::<Result<Vec<_>, _>>()
+            .map_err(StoreError::from)?;
+        if input.is_empty() {
+            break;
+        }
+        let ids = input
+            .iter()
+            .filter_map(|(_, _, id, _)| id.map(os_model::UrlId))
+            .collect::<Vec<_>>();
+        let mut query = q.clone();
+        query.columns = views::ColumnSelection::Named(page.columns.clone());
+        query.limit = 500;
+        query.start = PageStart::Offset(0);
+        let data = views::query_url_ids_in(tabs, file, cfg, &query, &ids, false)?;
+        let mut by_id = std::collections::HashMap::new();
+        for (id, row) in data.row_keys.into_iter().zip(data.rows) {
+            by_id.insert(id.0, row);
+        }
+        for (position, original, id, outcome) in input {
+            cursor = position.saturating_add(1);
+            let values = match id.and_then(|id| by_id.get(&id)) {
+                Some(row) => row.clone(),
+                None if q.search.is_none()
+                    && matches!(outcome.as_str(), "invalid" | "excluded" | "not_included") =>
+                {
+                    let mut row = vec![Value::Null; page.columns.len()];
+                    if let Some(i) = page.columns.iter().position(|c| c == "Status") {
+                        row[i] = Value::from(match outcome.as_str() {
+                            "invalid" => "Invalid",
+                            "excluded" => "Excluded",
+                            _ => "Not Included",
+                        });
+                    }
+                    row
+                }
+                None => continue,
+            };
+            let mut row = vec![Value::Text(original)];
+            row.extend(values);
+            out.row(&kinds, &row)?;
+        }
+    }
+    out.finish()
+}
