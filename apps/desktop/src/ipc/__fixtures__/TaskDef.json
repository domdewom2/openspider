{
  "id": null,
  "name": "Nightly",
  "project": "Shop",
  "enabled": true,
  "schedule": {
    "kind": "weekly",
    "days": [
      1,
      3,
      5
    ],
    "time": "02:30"
  },
  "crawl": {
    "source": {
      "kind": "spider",
      "url": "https://example.test/"
    },
    "profile": "shop",
    "overrides": {
      "speed.threads": 10
    }
  },
  "execution": {
    "headless": true,
    "timeoutMin": 120,
    "runIfMissed": true,
    "autoCompare": true
  },
  "apis": [
    "gsc"
  ],
  "exports": [
    {
      "kind": "bulk",
      "name": "All Inlinks",
      "format": "csv",
      "dir": null
    }
  ],
  "notify": {
    "onSuccess": false,
    "onFailure": true,
    "account": "work",
    "to": [
      "seo@example.test"
    ]
  },
  "exportOptions": null,
  "exportPreset": null,
  "customSummary": null
}
