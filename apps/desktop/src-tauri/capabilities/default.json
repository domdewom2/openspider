{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Berechtigungen der OpenSpider-Fenster: eigene Command-Dom\u00e4nen (aus commands.json, build.rs) und die Plugins der H\u00fclle",
  "windows": [
    "main",
    "settings",
    "viz-*"
  ],
  "permissions": [
    "core:default",
    "core:webview:allow-create-webview-window",
    "core:window:allow-set-title",
    "core:window:allow-set-position",
    "core:window:allow-set-size",
    "core:window:allow-set-focus",
    "core:window:allow-show",
    "core:window:allow-hide",
    "core:window:allow-close",
    "core:window:allow-minimize",
    "core:window:allow-is-minimized",
    "core:webview:allow-set-webview-zoom",
    "dialog:default",
    "notification:default",
    "clipboard-manager:allow-write-text",
    "os:default",
    "os-app:default",
    "settings:default",
    "uistate:default",
    "op:default",
    "events:default",
    "diag:default",
    "crawl:default",
    "analysis:default",
    "catalog:default",
    "view:default",
    "search:default",
    "detail:default",
    "sidebar:default",
    "config:default",
    "profile:default",
    "segment:default",
    "crawls:default",
    "projects:default",
    "export:default",
    "compare:default",
    "viz:default",
    "mcp:default",
    "api:default",
    "tasks:default",
    "auth:default",
    "mail:default",
    "update:default",
    "updater:default",
    "process:allow-restart"
  ]
}
