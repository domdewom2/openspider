{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpenSpider",
  "identifier": "org.openspider.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "OpenSpider",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 640
      },
      {
        "label": "settings",
        "title": "OpenSpider",
        "create": false,
        "width": 760,
        "height": 560,
        "minWidth": 640,
        "minHeight": 420,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: ospider: http://ospider.localhost; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost; worker-src 'self' blob:; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'",
      "devCsp": "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: ospider: http://ospider.localhost; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost http://localhost:1420 ws://localhost:1420; worker-src 'self' blob:; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "resources": {
      "../../../crates/os-render/resources/axe/axe.min.js": "axe/axe.min.js",
      "../../../crates/os-render/resources/axe/LICENSE": "axe/LICENSE",
      "../../../crates/os-render/resources/axe/THIRD_PARTY_NOTICES": "axe/THIRD_PARTY_NOTICES",
      "resources/third-party/": "third-party/"
    },
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "13.0",
      "hardenedRuntime": true,
      "entitlements": "entitlements.plist"
    },
    "fileAssociations": [
      {
        "ext": [
          "ospider"
        ],
        "name": "OpenSpider Crawl",
        "description": "OpenSpider Crawl",
        "mimeType": "application/vnd.openspider.crawl",
        "role": "Editor"
      },
      {
        "ext": [
          "osconfig"
        ],
        "name": "OpenSpider Konfiguration",
        "description": "OpenSpider Konfiguration",
        "mimeType": "application/vnd.openspider.config",
        "role": "Editor"
      },
      {
        "ext": [
          "osauth"
        ],
        "name": "OpenSpider Authentifizierungsprofile",
        "description": "OpenSpider Authentifizierungsprofile",
        "mimeType": "application/vnd.openspider.auth",
        "role": "Editor"
      },
      {
        "ext": [
          "ospreset"
        ],
        "name": "OpenSpider Vorgabe",
        "description": "OpenSpider Vorgabe",
        "mimeType": "application/vnd.openspider.preset",
        "role": "Editor"
      },
      {
        "ext": [
          "ostask"
        ],
        "name": "OpenSpider Aufgabe",
        "description": "OpenSpider Aufgabe",
        "mimeType": "application/vnd.openspider.task",
        "role": "Editor"
      }
    ],
    "createUpdaterArtifacts": true,
    "externalBin": [
      "binaries/openspider"
    ]
  },
  "version": "0.1.0",
  "plugins": {
    "updater": {
      "endpoints": [],
      "pubkey": ""
    }
  }
}
