    "extraction": {
      "$ref": "#/$defs/ExtractionConfig",
      "default": {
        "h1": true,
        "h2": true,
        "hash": true,
        "http_headers": true,
        "last_modified": true,
        "meta_description": true,
        "meta_keywords": true,
        "page_titles": true,
        "response_time": true,
        "store_html": false
      },
      "description": "Extraktion."
    },
    "generator": {
      "default": "openspider 0.1.0",
      "description": "Erzeuger, z. B. `openspider 0.1.0`.",
      "type": "string"
    },
    "h1": {
      "$ref": "#/$defs/HeadingLimits",
      "default": {
        "max_chars": 70
      },
      "description": "Schwelle für H1."
    },
    "h2": {
      "$ref": "#/$defs/HeadingLimits",
      "default": {
        "max_chars": 70
      },
      "description": "Schwelle für H2."
    },
    "hreflang": {
      "$ref": "#/$defs/HreflangConfig",
      "default": {
        "allow_script_subtag": true,
        "over_limit": "truncate"
      },
      "description": "hreflang."
