        },
        "follow_internal_nofollow": {
          "default": false,
          "description": "Interne nofollow-Links folgen.",
          "type": "boolean"
        },
        "hreflang": {
          "$ref": "#/$defs/StoreCrawl",
          "default": {
            "crawl": false,
            "store": true
          },
          "description": "hreflang."
        },
        "iframes": {
          "$ref": "#/$defs/StoreCrawl",
          "default": {
            "crawl": true,
            "store": true
          },
          "description": "Iframes."
        },
        "images": {
          "$ref": "#/$defs/StoreCrawl",
          "default": {
            "crawl": true,
            "store": true
          },
          "description": "Bilder."
        },
        "internal": {
          "$ref": "#/$defs/StoreCrawl",
          "default": {
            "crawl": true,
            "store": true
          },
          "description": "Interne Hyperlinks."
        },
        "javascript": {
          "$ref": "#/$defs/StoreCrawl",
          "default": {
            "crawl": true,
            "store": true
          },
          "description": "JavaScript."
        },
        "media": {
          "$ref": "#/$defs/StoreCrawl",
          "default": {
            "crawl": true,
            "store": true
          },
          "description": "Medien."
        },
        "meta_refresh": {
          "$ref": "#/$defs/StoreCrawl",
          "default": {
            "crawl": true,
            "store": true
          },
          "description": "Meta Refresh."
        },
        "mobile_alternate": {
          "$ref": "#/$defs/StoreCrawl",
          "default": {
            "crawl": false,
            "store": true
          },
          "description": "Mobile Alternate."
        },
        "pagination": {
          "$ref": "#/$defs/StoreCrawl",
          "default": {
            "crawl": false,
            "store": true
          },
          "description": "Paginierung."
        }
      },
      "type": "object"
    },
    "StoreCrawl": {
      "description": "Speichern und Crawlen je Linktyp.",
      "properties": {
        "crawl": {
          "default": true,
          "description": "Abrufen.",
          "type": "boolean"
        },
        "store": {
          "default": true,
          "description": "Im Crawl speichern.",
          "type": "boolean"
        }
      },
      "type": "object"
    },
    "TextLimits": {
      "description": "Schwellen für Zeichen und Pixel (Titel, Meta-Description; 02 §0.3).",
      "properties": {
        "max_chars": {
          "default": 60,
          "description": "Höchstzahl Zeichen.",
          "format": "uint32",
          "minimum": 1,
          "type": "integer"
        },
        "max_px": {
          "default": 561,
          "description": "Höchstbreite in Pixeln.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "min_chars": {
          "default": 30,
          "description": "Mindestzahl Zeichen.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "min_px": {
          "default": 200,
          "description": "Mindestbreite in Pixeln.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "type": "object"
    },
    "UrlLimits": {
      "description": "Schwelle für URLs (ONPAGE-081).",
      "properties": {
        "max_chars": {
          "default": 115,
