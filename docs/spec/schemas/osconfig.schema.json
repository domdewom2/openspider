          "mehr",
          "weiter",
          "weiterlesen",
          "mehr erfahren",
          "mehr lesen",
          "mehr info",
          "details ansehen"
        ]
      },
      "description": "Links-Tab."
    },
    "meta_description": {
      "$ref": "#/$defs/TextLimits",
      "default": {
        "max_chars": 155,
        "max_px": 985,
        "min_chars": 70,
        "min_px": 400
      },
      "description": "Schwellen für Meta Descriptions."
    },
    "mode": {
      "$ref": "#/$defs/CrawlMode",
      "default": "spider",
      "description": "Crawl-Modus."
    },
    "network": {
      "$ref": "#/$defs/NetworkConfig",
      "default": {
        "resolve": []
