        "urls": []
      },
      "description": "Sitemaps."
    },
    "speed": {
      "$ref": "#/$defs/SpeedConfig",
      "default": {
        "max_per_host": null,
        "max_urls_per_sec": null,
        "threads": 5
      },
      "description": "Geschwindigkeit."
    },
    "spider": {
      "$ref": "#/$defs/SpiderConfig",
      "default": {
        "amp": {
          "crawl": false,
          "store": false
        },
        "canonicals": {
          "crawl": true,
          "store": true
        },
        "css": {
          "crawl": true,
          "store": true
        },
        "external": {
          "crawl": true,
          "store": true
        },
        "follow_external_nofollow": false,
        "follow_internal_nofollow": false,
        "hreflang": {
          "crawl": false,
          "store": true
        },
        "iframes": {
          "crawl": true,
          "store": true
        },
        "images": {
          "crawl": true,
          "store": true
        },
        "internal": {
          "crawl": true,
          "store": true
        },
        "javascript": {
          "crawl": true,
          "store": true
        },
        "media": {
          "crawl": true,
          "store": true
        },
        "meta_refresh": {
          "crawl": true,
          "store": true
        },
        "mobile_alternate": {
          "crawl": false,
          "store": true
        },
        "pagination": {
          "crawl": false,
          "store": true
        }
      },
      "description": "Was gespeichert und gecrawlt wird."
    },
    "title": {
      "$ref": "#/$defs/TextLimits",
      "default": {
        "max_chars": 60,
        "max_px": 561,
        "min_chars": 30,
        "min_px": 200
      },
      "description": "Schwellen für Page Titles."
    },
    "url": {
      "$ref": "#/$defs/UrlLimits",
      "default": {
