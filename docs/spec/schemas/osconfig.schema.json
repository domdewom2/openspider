  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Crawl-Konfiguration von OpenSpider (TOML, OUT-221). Fehlende Schlüssel erhalten Standardwerte; unbekannte Schlüssel werden beim Laden gemeldet und ignoriert.",
  "properties": {
    "advanced": {
      "$ref": "#/$defs/AdvancedConfig",
      "default": {
        "assume_html": false,
        "cookies": "session_only",
        "respect_self_ref_meta_refresh": true,
        "response_timeout_s": 20
      },
      "description": "Erweiterte Einstellungen."
    },
    "analysis": {
      "$ref": "#/$defs/AnalysisConfig",
      "default": {
        "amp": true,
        "analytics": true,
        "auto_at_end": true,
        "canonicals": true,
        "content": true,
        "hreflang": true,
        "images": true,
        "link_metrics": true,
        "link_score": true,
        "links": true,
        "pagination": true,
        "search_console": true,
        "sitemaps": true
      },
      "description": "Crawl-Analyse."
    },
    "auth": {
      "$ref": "#/$defs/AuthConfig",
      "default": {
        "basic": []
      },
