      "default": {
        "store": false
      },
      "description": "PDF."
    },
    "rendering": {
      "$ref": "#/$defs/RenderingConfig",
      "default": {
        "mode": "text"
      },
      "description": "Rendering."
    },
    "robots": {
      "$ref": "#/$defs/RobotsConfig",
      "default": {
        "mode": "respect",
        "retries": 2,
        "retry_delay_s": 5,
        "unreachable_policy": "block_host"
      },
      "description": "robots.txt."
