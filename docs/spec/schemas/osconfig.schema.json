            "nav",
            "footer"
          ],
          "exclude_ids": [],
          "include_classes": [],
          "include_elements": [],
          "include_ids": []
        },
        "low_word_count": 200,
        "soft404_phrases": [
          "page not found",
          "404 not found",
          "error 404",
          "404 error",
          "page cannot be found",
          "page can't be found",
          "page could not be found",
          "seite nicht gefunden",
          "seite wurde nicht gefunden",
          "fehler 404",
          "404 fehler",
          "page introuvable",
          "página no encontrada",
          "pagina non trovata",
          "pagina niet gevonden"
        ]
      },
      "description": "Inhaltsbereich und Content-Filter."
    },
    "duplicates": {
      "$ref": "#/$defs/DuplicatesConfig",
      "default": {
        "exact_enabled": true,
        "ignore_paginated": true,
        "near_enabled": false,
        "near_threshold_pct": 90,
        "only_indexable": true
      },
      "description": "Duplikaterkennung."
    },
    "export": {
      "$ref": "#/$defs/ExportConfig",
      "default": {
