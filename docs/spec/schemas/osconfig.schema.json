      "minimum": 1,
      "type": "integer"
    },
    "scope": {
      "$ref": "#/$defs/ScopeConfig",
      "default": {
        "all_subdomains": false,
        "crawl_outside_start_folder": false,
        "exclude": [],
        "include": [],
        "regex_partial_match": false,
        "subfolder_only": false
      },
      "description": "Bereich und Include/Exclude."
    },
    "sitemaps": {
      "$ref": "#/$defs/SitemapsConfig",
      "default": {
