# Umgebung von openspider-shadow.service (EnvironmentFile, deploy.sh legt die Datei unter etc/ ab).
# Nur Werte ohne Geheimnisse: Der Autonomo-Token wird zur Laufzeit aus dessen Konfiguration gelesen
# (compare.py fetch-autonomo), nie hierher kopiert.

# Sites, nacheinander (nie parallel), als Hostname; Start-URL ist https://<host>/
SHADOW_SITES="caloone.de rotweine.org"
# Aufbewahrung: so viele Crawl-Dateien/Exporte je Site bleiben
SHADOW_KEEP=4
# Abbruch, wenn auf / weniger Gigabyte frei sind
SHADOW_MIN_FREE_GB=8
# Quelle der Autonomo-Befunde: api (GET /api/extern) oder psql (nur lesend); Einstellungen in etc/autonomo-source.toml
SHADOW_AUTONOMO_SOURCE=api
