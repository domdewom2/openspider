# OpenSpider-Konfiguration fuer Paritaetslaeufe gegen die Referenz-Exporte (docs/plan/M1.md 5.3).
# Entspricht der tatsaechlichen Referenzkonfiguration (Referenzprodukt 24.3 Free, K-53): In der Free-Version ist die
# Spider-Konfiguration gesperrt, gecrawlt wurde mit den Standardwerten. Hreflang und Pagination wurden nur
# gespeichert, nicht gecrawlt; verlinkte XML-Sitemaps wurden nicht gecrawlt (Erkennung ueber robots.txt an,
# aber ohne Abruf). Beide Seiten vergleichen so dieselbe Konfiguration. Alle nicht genannten Schluessel
# behalten ihre Standardwerte.
schema_version = 1
generator = "openspider 0.1.0"
mode = "spider"

[spider]
follow_internal_nofollow = false
follow_external_nofollow = false

[spider.canonicals]
store = true
crawl = true

[spider.hreflang]          # Referenz (Free): nur speichern, nicht crawlen (TECH-071)
store = true
crawl = false

[spider.pagination]
store = true
crawl = false

[robots]
respect_crawl_delay = false
mode = "respect"
unreachable_policy = "allow_all"   # bewusste OS-Festlegung (K-55): OpenSpider sperrt den Host (RFC 9309), das Profil stellt die Referenz nach, die trotzdem crawlt (CRAWL-100, Q30)

[advanced]
cookies = "session_only"
response_timeout_s = 20
assume_html = false
respect_self_ref_meta_refresh = false   # seit K-57 Standard (TECH-068): ein Selbst-Refresh wirkt nur mit dieser Option auf die Indexierbarkeit, wie in der Referenz; die Zeile bleibt zur Klarheit

[sitemaps]                 # TECH-210: Referenz (Free) ruft keine Sitemap ab; OpenSpider ruft ohne crawl_linked keine ab
crawl_linked = false
auto_discover_robots = true

[analysis]                 # Nachlauf (Canonicals, Sitemaps, Links) am Crawl-Ende
auto_at_end = true

# Defaults des bestehenden Paritätsprofils bewahren (CRAWL-010, CRAWL-062; K2-29).
[scope]
crawl_outside_start_folder = false

[extraction]
http_headers = true
