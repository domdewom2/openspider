+        None,
+        "Storage.getCookies",
+        json!({"browserContextId": info["targetInfo"]["browserContextId"]}),
+    )
+    .await?;
+    Ok(
+        serde_json::from_value::<chromiumoxide::cdp::browser_protocol::storage::GetCookiesReturns>(
+            value,
+        )
+        .map_err(protocol)?
+        .cookies,
+    )
