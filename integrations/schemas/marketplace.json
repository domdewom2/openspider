{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "OpenSpider local-path marketplace manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "owner", "plugins"],
  "properties": {
    "name": { "type": "string", "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$" },
    "description": { "type": "string", "minLength": 1 },
    "owner": { "type": "object", "additionalProperties": false, "required": ["name"], "properties": { "name": { "type": "string", "minLength": 1 } } },
    "plugins": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["name", "source", "description"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "source": { "type": "string", "pattern": "^\\./[a-z0-9/-]+$" },
          "description": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
