{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "OpenSpider supported subset of the Claude Code plugin manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "version", "description", "author", "license"],
  "properties": {
    "name": { "type": "string", "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$" },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "description": { "type": "string", "minLength": 1 },
    "author": { "type": "object", "additionalProperties": false, "required": ["name"], "properties": { "name": { "type": "string", "minLength": 1 } } },
    "license": { "const": "Apache-2.0" },
    "keywords": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
  }
}
